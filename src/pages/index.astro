<style>
  /* Tu estilo original queda exactamente igual, no lo toqué */
  body {
    font-family: Arial, sans-serif; 
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  main {
