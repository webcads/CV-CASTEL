<style>
  body {
    font-family: Arial, sans-serif; 
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  main {
    width: 28cm;
    height: max-content;
    min-height: 29.7cm;
    max-height: max-content;    
    padding: 2.6vw;
    padding: 0.5vw;
    display: flex;
  }
  ul div div {
    font-size: 14px;
  }

  main .col { padding: 20px; }
  main .column1 { flex: 1; text-align: right; }

  .column2 { width: 30%; text-align: center; padding: 20px; }

  .hexagon {
    background: #fff;
    width: 120px;
    height: 135px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    margin: 0 auto;
  }

  hr { border: 1px dashed white; }

  .column3 { flex: 1; padding: 20px; color: white; }

  .custom-checkbox {
    width: 12px;  
    height: 12px;
    border: 1px solid #6597c9;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
    background-color: #545a7300;
    cursor: pointer;
  }

  .custom-checkbox.checked {
    background-color: #6597c9;
  }

  .section h2 {
    border: none;
    font-weight: lighter;
    border-top: 2.9px dotted rgb(117, 117, 117);
    border-bottom: 2.9px dotted rgb(117, 117, 117);
  }
  .col .section { margin-top: 25px; }
</style>

<script is:inline>
  function toggleCheckbox(checkbox) {
    checkbox.classList.toggle("checked");
  }
</script>

<script is:inline>
  async function exportToPDF() {
    const mainContent = document.querySelector("main");
    await waitForImagesToLoad(mainContent);

    const pdfOptions = {
      margin: 0,
      filename: "Ivan Castillo - Analista de Servicios y Controles TI.pdf",
      image: { type: "jpeg", quality: 0.98 },
      html2canvas: { scale: 1 },
      jsPDF: { unit: "cm", format: "a4", orientation: "portrait" },
    };

    html2pdf().from(mainContent).set(pdfOptions).save();
  }

  async function waitForImagesToLoad(container) {
    const images = container.querySelectorAll("img");
    const imageLoadPromises = [];
    images.forEach((image) => {
      const imageLoadPromise = new Promise((resolve) => {
        if (image.complete) resolve();
        else image.onload = resolve;
      });
      imageLoadPromises.push(imageLoadPromise);
    });
    await Promise.all(imageLoadPromises);
  }
</script>